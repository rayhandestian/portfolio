---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** Homepage-only hreflang tags; pages without a translated twin opt out. */
  alternates?: boolean;
}

const { 
  title, 
  description = "Full-stack developer building and operating web applications and game systems with TypeScript, React and Next.js.",
  lang = "en",
  alternates = true
} = Astro.props;

// Canonical domain comes from `site` in astro.config.mjs
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://rayhan.ch';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Rayhan Destian" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
    
    <!-- i18n Alternate Links -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={siteUrl} />
        <link rel="alternate" hreflang="id" href={`${siteUrl}/id/`} />
        <link rel="alternate" hreflang="x-default" href={siteUrl} />
      </>
    )}

    <title>{title}</title>
    <script is:inline>
      // Apply theme before render to avoid flash
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1.0,
          smoothTouch: false,
          touchMultiplier: 2,
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
