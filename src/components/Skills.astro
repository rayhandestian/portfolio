---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const skillGroups = [
  {
    category: t('skills.categories.languages'),
    skills: ["TypeScript", "JavaScript", "Java", "Python", "Dart", "SQL"],
  },
  {
    category: t('skills.categories.frameworks'),
    skills: ["Next.js", "React", "Node.js", "Hono", "Tailwind CSS", "Prisma", "Flutter", "discord.js"],
  },
  {
    category: t('skills.categories.web'),
    skills: [t('skills.items.payments'), "Webhooks", t('skills.items.authentication')],
  },
  {
    category: t('skills.categories.security'),
    skills: [t('skills.items.security_research'), t('skills.items.vulnerability_discovery'), t('skills.items.privacy')],
  },
  {
    category: t('skills.categories.game_dev'),
    skills: ["Spigot", "Velocity", "Skript", t('skills.items.plugin_development'), t('skills.items.gameplay_systems')],
  },
  {
    category: t('skills.categories.databases'),
    skills: ["MongoDB", "MariaDB", "PostgreSQL", "Redis", "Cloudflare D1", "Cloudflare KV", "Supabase", "Firebase"],
  },
  {
    category: t('skills.categories.devops'),
    skills: ["Docker", "Linux", "Pterodactyl", "Cloudflare Workers", "DNS Management"],
  },
  {
    category: t('skills.categories.other'),
    skills: [t('skills.items.data_visualization'), "TensorFlow", "IoT (ESP32)"],
  },
];
---

<section class="section" id="skills">
  <div class="container">
    <h2 class="section-title">{t('skills.title')}</h2>
    <p class="section-subtitle">{t('skills.subtitle')}</p>
    <div class="skills card">
      {skillGroups.map(group => (
        <div class="skill-row">
          <h3 class="skill-category">{group.category}</h3>
          <div class="skill-items">
            {group.skills.map(skill => (
              <span class="tag">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding: var(--space-xs) var(--space-lg);
    text-align: left;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-md) 0;
  }

  .skill-row + .skill-row {
    border-top: 1px solid var(--color-border);
  }

  .skill-category {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .skill-items .tag {
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .skills {
      padding: var(--space-xs) var(--space-md);
    }

    .skill-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-sm);
    }
  }
</style>
