---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cveIds = ["CVE-2026-47285", "CVE-2026-65675", "CVE-2026-40400"];
const cveEntries = (t('achievements.items.cve.advisories') as unknown as string[]).map((text, i) => ({
  text,
  id: cveIds[i],
  href: `https://msrc.microsoft.com/update-guide/vulnerability/${cveIds[i]}`,
}));

const achievements = [
  {
    date: t('achievements.items.cve.date'),
    title: t('achievements.items.cve.title'),
    badge: "3 CVEs",
    entries: cveEntries,
  },
  {
    date: t('achievements.items.upercase.date'),
    title: t('achievements.items.upercase.title'),
    badge: "Top 7 / 31",
    entries: [
      {
        text: t('achievements.items.upercase.description'),
        id: t('achievements.items.upercase.link'),
        href: "/docs/sertifikat-uper-case-ib-2025.pdf",
      },
    ],
  },
];
---

<section class="section" id="achievements">
  <div class="container">
    <h2 class="section-title">{t('achievements.title')}</h2>
    <p class="section-subtitle">{t('achievements.subtitle')}</p>
    <div class="achievements-grid">
      {achievements.map(item => (
        <article class="achievement card">
          <div class="achievement-meta">
            <span class="achievement-badge">{item.badge}</span>
            <span class="achievement-date">{item.date}</span>
          </div>
          <h3 class="achievement-title">{item.title}</h3>
          <div class="achievement-entries">
            {item.entries.map(entry => (
              <div class="achievement-entry">
                <p class="achievement-description">{entry.text}</p>
                <a href={entry.href} target="_blank" rel="noopener" class="btn btn-outline btn-sm achievement-link">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  {entry.id}
                </a>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: start;
    gap: var(--space-lg);
    max-width: 900px;
    margin: 0 auto;
  }

  .achievement {
    padding: var(--space-lg);
    text-align: left;
    display: flex;
    flex-direction: column;
  }

  .achievement-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .achievement-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .achievement-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .achievement-title {
    font-size: 1.1rem;
    margin-bottom: var(--space-sm);
  }

  .achievement-entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    flex-grow: 1;
  }

  .achievement-entry {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .achievement-description {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .achievement-link {
    align-self: flex-start;
  }
</style>
