---
// ProjectRow.astro - One project as a row that opens to show its details.
interface StackItem {
  name: string;
  icon: string | null;
}

interface ExtraLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  tagline: string;
  description: string;
  stack?: StackItem[];
  link?: string;
  github?: string;
  image?: string;
  extraLinks?: ExtraLink[];
}

const { title, tagline, description, stack = [], link, github, image, extraLinks = [] } = Astro.props;
---

<details class="project">
  <summary class="project-summary">
    <span class="project-heading">
      <span class="project-title">{title}</span>
      <span class="project-tagline">{tagline}</span>
    </span>
    <svg class="project-chevron" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </summary>
  <div class:list={["project-body", { "has-image": image }]}>
    <div class="project-text">
      <p class="project-description">{description}</p>
      {stack.length > 0 && (
        <div class="project-stack">
          {stack.map(item => (
            <span class="tag">
              {item.icon && <Fragment set:html={item.icon} />}
              {item.name}
            </span>
          ))}
        </div>
      )}
      {(link || github || extraLinks.length > 0) && (
        <div class="project-links">
          {link && (
            <a href={link} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              Visit Website
            </a>
          )}
          {github && (
            <a href={github} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              Source
            </a>
          )}
          {extraLinks.map(extra => (
            <a href={extra.href} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              {extra.label}
            </a>
          ))}
        </div>
      )}
    </div>
    {image && (
      <button type="button" class="project-image-button" aria-haspopup="dialog" data-lightbox={image}>
        <img class="project-image" src={image} alt={`${title} screenshot`} width="1920" height="1080" loading="lazy" />
      </button>
    )}
  </div>
</details>

<style>
  .project {
    border-top: 1px solid var(--color-border);
  }

  .project-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 0.8rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .project-summary::-webkit-details-marker {
    display: none;
  }

  .project-summary:hover {
    background: var(--color-accent-soft);
  }

  .project-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .project-heading {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .project-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .project-tagline {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .project-chevron {
    flex-shrink: 0;
    color: var(--color-text-secondary);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .project-summary:hover .project-chevron {
    color: var(--color-accent);
  }

  .project[open] .project-chevron {
    transform: rotate(180deg);
  }

  .project-body {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xs) 0 var(--space-lg);
  }

  @media (min-width: 760px) {
    .project-body.has-image {
      grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
      align-items: start;
    }
  }

  .project-description {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .project-image-button {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: var(--radius-md);
    cursor: zoom-in;
  }

  .project-image-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .project-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }

  .project-image-button:hover .project-image {
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-summary,
    .project-chevron {
      transition: none;
    }
  }
</style>
